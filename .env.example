# Kopiert diese Datei nach .env und tragt eure Werte ein:  cp .env.example .env
# Es gehoert KEIN Key in diese Datei — authentifiziert wird ueber `az login`.

# Foundry-Projekt-Endpoint, Portal → Projektuebersicht → "Azure AI Foundry project endpoint"
# Form: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_ENDPOINT=

# Deployment-Name aus "Models + endpoints", Spalte "Name".
# ACHTUNG: der Deployment-Name, nicht der Modellname aus dem Katalog.
MODEL_DEPLOYMENT=

# Name eures Agents in Lab 2 und 3. Bitte eindeutig waehlen (z. B. Kuerzel anhaengen),
# damit ihr im Portal euren eigenen Agenten wiederfindet.
AGENT_NAME=workshop-agent

# Nur fuer Lab 3, Variante B (MCP). Vorbereiteter, oeffentlicher MCP-Server.
MCP_SERVER_LABEL=api-specs
MCP_SERVER_URL=https://gitmcp.io/Azure/azure-rest-api-specs
